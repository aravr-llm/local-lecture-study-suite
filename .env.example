# ==============================================================================
# LocalLecture Configuration Template (.env.example)
# Copy this file to .env for custom local settings.
# NOTE: All AI, transcription, and data storage runs 100% LOCALLY on this machine.
# ==============================================================================

# Server configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# Database path (local SQLite file)
DATABASE_PATH=./data/local_lecture.db

# Storage directories for recordings and exports
STORAGE_DIR=./data

# Local AI Engine Configuration
# Supported providers: ollama | llamacpp | mock
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.2
LOCAL_AI_TIMEOUT_MS=120000

# Local Speech-to-Text (Whisper) Configuration
# Supported providers: local | python | mock
WHISPER_PROVIDER=local
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# Session security
# A random 64-character hex key will be auto-generated at first boot if left empty
SESSION_SECRET=
SESSION_TTL_HOURS=168

# Telemetry / External network (STRICTLY DISABLED)
ENABLE_TELEMETRY=false
ALLOW_EXTERNAL_AI=false
